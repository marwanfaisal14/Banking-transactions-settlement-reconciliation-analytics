          }
        ],
        "partitions": [
          {
            "name": "Metrics",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "#table(type table [Anchor = Int64.Type], {{1}})"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Ledger Records",
            "expression": [
              "COALESCE(COUNTROWS('Ledger'), 0)"
            ],
            "formatString": "#,0",
            "displayFolder": "Ledger controls",
            "lineageTag": "9ea4d27c-41c1-5ed2-8703-9a9033e7dbbf"
          },
          {
            "name": "Eligible Due Transactions",
            "expression": [
              "VAR Cutoff = MAX('RunMetadata'[as_of])",
              "RETURN COALESCE(COUNTROWS(FILTER('Ledger', 'Ledger'[eligible] = TRUE() && 'Ledger'[due_date] <= Cutoff)), 0)"
            ],
            "formatString": "#,0",
            "displayFolder": "Ledger controls",
            "lineageTag": "d3330b59-b9ec-5c8b-b875-a899585f3e35"
          },
          {
            "name": "Matched Due Transactions",
            "expression": [
              "VAR Cutoff = MAX('RunMetadata'[as_of])",
              "RETURN COALESCE(COUNTROWS(FILTER('Ledger', 'Ledger'[eligible] = TRUE() && 'Ledger'[due_date] <= Cutoff && 'Ledger'[matched] = TRUE())), 0)"
            ],
            "formatString": "#,0",
            "displayFolder": "Ledger controls",
            "lineageTag": "a5457f30-2e14-5e7f-8d3d-0c6bb85889b7"
          },
          {
            "name": "Open Due Transactions",
            "expression": [
              "[Eligible Due Transactions] - [Matched Due Transactions]"
            ],
            "formatString": "#,0",
            "displayFolder": "Ledger controls",
            "lineageTag": "45a43ce6-1214-558a-b24e-00d5e6cf5ac5"
          },
          {
            "name": "Ledger Match Rate",
            "expression": [
              "DIVIDE([Matched Due Transactions], [Eligible Due Transactions])"
            ],
            "formatString": "0.00%",
            "displayFolder": "Ledger controls",
            "lineageTag": "6dd891dc-e1ba-5e5b-b157-0251ddc5d47f"
          },
          {
            "name": "Expected Due Net",
            "expression": [
              "VAR Cutoff = MAX('RunMetadata'[as_of])",
              "RETURN IF(HASONEVALUE('Currency'[currency]), DIVIDE(SUMX(FILTER('Ledger', 'Ledger'[eligible] = TRUE() && 'Ledger'[due_date] <= Cutoff), 'Ledger'[expected_net_minor]), 100))"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Ledger controls",
            "lineageTag": "ea20caf2-b295-5e92-b35b-e80994b23bdd"
          },
          {
            "name": "Ledger Absolute Variance",
            "expression": [
              "VAR Cutoff = MAX('RunMetadata'[as_of])",
              "RETURN IF(HASONEVALUE('Currency'[currency]), DIVIDE(SUMX(FILTER('Ledger', 'Ledger'[eligible] = TRUE() && 'Ledger'[due_date] <= Cutoff && NOT(ISBLANK('Ledger'[net_delta_minor]))), ABS('Ledger'[net_delta_minor])), 100))"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Ledger controls",
            "lineageTag": "96d069de-ce04-5a4b-90fd-e1f887e33943"
          },
          {
            "name": "Incompatible Ledger References",
            "expression": [
              "VAR Cutoff = MAX('RunMetadata'[as_of])",
              "RETURN COALESCE(COUNTROWS(FILTER('Ledger', 'Ledger'[eligible] = TRUE() && 'Ledger'[due_date] <= Cutoff && ISBLANK('Ledger'[net_delta_minor]))), 0)"
            ],
            "formatString": "#,0",
            "displayFolder": "Ledger controls",
            "lineageTag": "3a354cb3-00f4-5e7a-9ef2-6caf4ad9652b"
          },
          {
            "name": "Incompatible Expected Net",
            "expression": [
              "VAR Cutoff = MAX('RunMetadata'[as_of])",
              "RETURN IF(HASONEVALUE('Currency'[currency]), DIVIDE(SUMX(FILTER('Ledger', 'Ledger'[eligible] = TRUE() && 'Ledger'[due_date] <= Cutoff && ISBLANK('Ledger'[net_delta_minor])), 'Ledger'[expected_net_minor]), 100))"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Ledger controls",
            "lineageTag": "c0a6c1c4-e3ab-5397-928e-90632acaff13"
          },
          {
            "name": "Expected Fees Due",
            "expression": [
              "VAR Cutoff = MAX('RunMetadata'[as_of])",
              "RETURN IF(HASONEVALUE('Currency'[currency]), DIVIDE(SUMX(FILTER('Ledger', 'Ledger'[eligible] = TRUE() && 'Ledger'[due_date] <= Cutoff), 'Ledger'[expected_fee_minor]), 100))"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Ledger controls",
            "lineageTag": "d1680ff2-c551-5e13-8aec-d8f6fa571221"
          },
          {
            "name": "Bank Batch Records",
            "expression": [
              "COALESCE(COUNTROWS('BankBatches'), 0)"
            ],
            "formatString": "#,0",
            "displayFolder": "Bank controls",
            "lineageTag": "80b0564d-b284-5e97-a1c4-733376ccafc1"
          },
          {
            "name": "Due Bank Batches",
            "expression": [
              "VAR Cutoff = MAX('RunMetadata'[as_of])",
              "RETURN COALESCE(COUNTROWS(FILTER('BankBatches', 'BankBatches'[due_date] <= Cutoff)), 0)"
            ],
            "formatString": "#,0",
            "displayFolder": "Bank controls",
            "lineageTag": "2de407aa-4933-5a11-aa62-920c8bb001a2"
          },
          {
            "name": "Matched Due Bank Batches",
            "expression": [
              "VAR Cutoff = MAX('RunMetadata'[as_of])",
              "RETURN COALESCE(COUNTROWS(FILTER('BankBatches', 'BankBatches'[due_date] <= Cutoff && 'BankBatches'[matched] = TRUE())), 0)"
            ],
            "formatString": "#,0",
            "displayFolder": "Bank controls",
            "lineageTag": "024f142b-edc1-5c08-bf9c-95a4930c4956"
          },
          {
            "name": "Bank Match Rate",
            "expression": [
              "DIVIDE([Matched Due Bank Batches], [Due Bank Batches])"
            ],
            "formatString": "0.00%",
            "displayFolder": "Bank controls",
            "lineageTag": "7c306065-3f99-5728-bf99-976abeb95509"
          },
          {
            "name": "Expected Due Bank Net",
            "expression": [
              "VAR Cutoff = MAX('RunMetadata'[as_of])",
              "RETURN IF(HASONEVALUE('Currency'[currency]), DIVIDE(SUMX(FILTER('BankBatches', 'BankBatches'[due_date] <= Cutoff), 'BankBatches'[expected_net_minor]), 100))"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Bank controls",
            "lineageTag": "797b8ae0-2bde-53d7-805b-c9b95436bcf4"
          },
          {
            "name": "Actual Due Bank Net",
            "expression": [
              "VAR Cutoff = MAX('RunMetadata'[as_of])",
              "RETURN IF(HASONEVALUE('Currency'[currency]), DIVIDE(SUMX(FILTER('BankBatches', 'BankBatches'[due_date] <= Cutoff), 'BankBatches'[actual_net_minor]), 100))"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Bank controls",
            "lineageTag": "b0a8ad56-2a53-5c33-ba8b-e77d304aab2d"
          },
          {
            "name": "Bank Absolute Variance",
            "expression": [
              "VAR Cutoff = MAX('RunMetadata'[as_of])",
              "RETURN IF(HASONEVALUE('Currency'[currency]), DIVIDE(SUMX(FILTER('BankBatches', 'BankBatches'[due_date] <= Cutoff && NOT(ISBLANK('BankBatches'[net_delta_minor]))), ABS('BankBatches'[net_delta_minor])), 100))"
            ],
            "formatString": "#,0.00",
            "displayFolder": "Bank controls",
            "lineageTag": "1b88a78b-9d1f-5d56-a989-5f43f3979f66"
          },
          {
            "name": "Exception Records",
            "expression": [
              "COALESCE(COUNTROWS('Exceptions'), 0)"
            ],
            "formatString": "#,0",
            "displayFolder": "Exceptions",
            "lineageTag": "aae25359-8bb2-5094-a8ba-1e78e51a3190"
          },
          {
            "name": "High Priority Records",
            "expression": [
              "COALESCE(COUNTROWS(FILTER('Exceptions', 'Exceptions'[severity] = \"HIGH\")), 0)"
            ],
            "formatString": "#,0",
            "displayFolder": "Exceptions",
            "lineageTag": "ec404cca-9d6f-5e5a-a14f-cf2a30774bb2"
          },
          {
            "name": "Aged High Priority Records",
            "expression": [
              "VAR Grace = MAX('RunMetadata'[grace_business_days])",
              "RETURN COALESCE(COUNTROWS(FILTER('Exceptions', 'Exceptions'[severity] = \"HIGH\" && 'Exceptions'[age_business_days] > Grace)), 0)"
            ],
            "formatString": "#,0",
            "displayFolder": "Exceptions",
            "lineageTag": "809de39e-c9f4-5dda-8044-99b47dfe6205"
          },
          {
            "name": "Late Settlement Events",
            "expression": [
              "COALESCE(COUNTROWS(FILTER('Exceptions', 'Exceptions'[code] = \"LATE_SETTLEMENT\")), 0)"
            ],
            "formatString": "#,0",
            "displayFolder": "Ledger controls",
            "lineageTag": "484e0c9d-8c1c-53c4-b97b-1bf085fffcaf"
          }
        ]
      }
