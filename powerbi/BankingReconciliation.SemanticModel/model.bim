            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Payload = Text.Combine({",
                "        \"YXNfb2YsZ3JhY2VfYnVzaW5lc3NfZGF5cwoyMDI2LTEwLTI2LDEK\"",
                "    }),",
                "    Source = Csv.Document(Binary.FromText(Payload, BinaryEncoding.Base64), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Nulls = Table.ReplaceValue(Headers, \"\", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),",
                "    Typed = Table.TransformColumnTypes(Nulls, {{\"as_of\", type date}, {\"grace_business_days\", Int64.Type}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
